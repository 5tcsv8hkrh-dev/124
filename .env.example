# Copy this file to a new file named ".env" (same folder) and fill in your own values.
# The ".env" file is ignored by Git. NEVER put a real key in this example file.

# Your Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use. Optional. See README "Choosing a Gemini model".
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional settings
PORT=3000
GEMINI_TIMEOUT_MS=20000
RATE_LIMIT_PER_MINUTE=6
